# Copy to .env.local (never commit real keys).
# Server-side only: used by /api/assistant to call Claude. Without it the
# DotSeek Assistant falls back to its built-in answers.
ANTHROPIC_API_KEY=

# Optional: Google Search Console verification token.
GOOGLE_SITE_VERIFICATION=

# Chat enquiries (/api/enquiry): emailed to ENQUIRY_TO (defaults to the site email).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ENQUIRY_TO=
ENQUIRY_FROM=
# Set to 1 locally to log enquiries instead of sending them.
ENQUIRY_DRY_RUN=

# Enquiry storage (admin inbox + customer threads): Upstash Redis / Vercel KV.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Admin inbox at /admin. ADMIN_SECRET signs sessions (defaults to ADMIN_PASSWORD).
ADMIN_PASSWORD=
ADMIN_SECRET=

# Optional: override the origin used in email links (e.g. http://localhost:3100 locally).
SITE_URL=
